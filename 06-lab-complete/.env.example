# ============================================================
# Biến môi trường của agent. KHÔNG ghi secret thật vào file này.
# Dùng: cp .env.example .env  (file .env đã nằm trong .gitignore)
# Trên Railway/Render: đặt các biến này trên dashboard của platform.
# ============================================================

# Server
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
# Số uvicorn worker trong container (mặc định 2)
WEB_CONCURRENCY=2

# App
APP_NAME=production-ai-agent
APP_VERSION=1.0.0

# Security — bắt buộc; tạo bằng: python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_API_KEY=

# Redis (docker compose tự đặt redis://redis:6379/0)
REDIS_URL=redis://localhost:6379/0

# Rate limit: số request / 60 giây cho mỗi API key
RATE_LIMIT_PER_MINUTE=10

# Cost guard (USD, tính cho toàn agent)
DAILY_BUDGET_USD=1.0
MONTHLY_BUDGET_USD=10.0
